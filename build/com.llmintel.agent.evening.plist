<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.llmintel.agent.evening</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Applications/LLMIntelAgent.app/Contents/MacOS/LLMIntelAgent</string>
    <string>--run-daily</string>
    <string>--slot</string>
    <string>evening</string>
  </array>
  <!-- 每天 20:00 触发；机器睡着则唤醒后补跑（程序内时段守卫会再判一次） -->
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>20</integer><key>Minute</key><integer>0</integer></dict>
  <key>RunAtLoad</key><false/>
  <key>StandardOutPath</key><string>/tmp/llmintel.evening.out</string>
  <key>StandardErrorPath</key><string>/tmp/llmintel.evening.err</string>
  <key>ProcessType</key><string>Background</string>
  <key>LowPriorityIO</key><true/>
  <key>ThrottleInterval</key><integer>600</integer>
</dict>
</plist>
